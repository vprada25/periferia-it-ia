{
  "name": "reto-03-oc-sap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-modulo.ts && bun run --cwd app/web build",
    "start": "bun scripts/start.ts",
    "demo": "bun run demo.ts",
    "test": "bun test app",
    "typecheck": "bun run --cwd app/contracts typecheck && bun run --cwd app/backend typecheck && bun run --cwd app/agent typecheck && bun run --cwd app/web typecheck",
    "mcp": "bun app/backend/src/interfaces/mcp/stdio.ts",
    "a2a:demo": "bun scripts/a2a-client.ts",
    "modulo": "bun scripts/build-modulo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@oc/contracts": "workspace:*",
    "@oc/backend": "workspace:*",
    "@oc/agent": "workspace:*"
  }
}
