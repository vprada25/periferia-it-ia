# Copy to .env (never commit it). `bun run dev` loads it and passes it to the three processes.

# --- Agent / LLM (only the chat needs the key; demo.ts, MCP and A2A do not) ---
ANTHROPIC_API_KEY=
# Only if the key is organization-level (not scoped to a workspace): wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# Development: claude-sonnet-5-5 · Defense (if credit allows): claude-opus-5-5
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=60000

# --- Cost limits ---
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=200000

# --- Ports and internal URLs (three processes; only the web is public) ---
PORT=3000
BACKEND_PORT=4000
AGENT_PORT=4100
BACKEND_URL=http://localhost:4000
AGENT_URL=http://localhost:4100
# Public URL published by the A2A Agent Card. On Render: https://<service>.onrender.com
PUBLIC_URL=http://localhost:3000

# --- Security and integrations ---
# Optional: protects the web (login), /api, /mcp and /a2a (Authorization: Bearer <ACCESS_KEY>)
ACCESS_KEY=
# Sites allowed to frame the chat (/embed), comma separated
EMBED_ORIGINS=
# Whether an A2A client agent may approve confirmations (otherwise the analyst approves them in the web)
A2A_ALLOW_CONFIRM=false

# --- Optional (ADR-015, only if implemented) ---
DATABASE_URL=
