# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.

# --- Proveedor LLM (obligatoria para el chat; demo.ts, MCP y A2A no la necesitan) ---
ANTHROPIC_API_KEY=
# Desarrollo: claude-sonnet-5-5. Defensa (si hay saldo): claude-opus-5-5
LLM_MODEL=claude-sonnet-5-5
# Esfuerzo de razonamiento: low | medium | high
LLM_EFFORT=low
# Tiempo máximo por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000

# --- Control de costo ---
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=200000

# --- Servidor ---
PORT=3000
# URL pública (la publica la Agent Card de A2A). En Render: https://<servicio>.onrender.com
PUBLIC_URL=http://localhost:3000
# Opcional: protege la web, /api, /mcp y /a2a. Se envía como "Authorization: Bearer <ACCESS_KEY>"
ACCESS_KEY=

# --- Integraciones ---
# Sitios que pueden embeber el chat (separados por coma). Vacío = solo el mismo origen
EMBED_ORIGINS=
# Si un agente cliente A2A puede aprobar confirmaciones (si no, se aprueban en la web)
A2A_ALLOW_CONFIRM=false

# --- Opcional (ADR-015, solo si se implementa) ---
DATABASE_URL=
